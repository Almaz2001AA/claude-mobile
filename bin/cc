#!/usr/bin/env bash
# cc: quick launcher for Claude Code tmux sessions from the PC over SSH.
# See README "Быстрый запуск с ПК: cc" for usage and PowerShell setup.
#
# Sessions live in the same tmux namespace (claude-<name>) that claude-mobile
# manages, so a session started here shows up in the app and vice versa.

set -u

CM_HOME="${CLAUDE_MOBILE_HOME:-$HOME/.config/claude-mobile}"
FAVORITES_FILE="$CM_HOME/favorites.json"
# CLAUDE_PROJECTS_ROOT is test-only: it isolates tests from the user's real ~/.claude/projects.
PROJECTS_ROOT="${CLAUDE_PROJECTS_ROOT:-$HOME/.claude/projects}"

# CC_TMUX_SOCKET is test-only: it isolates tests on a private socket instead of
# the real one that holds the user's actual Claude sessions.
TMUX_ARGS=()
if [ -n "${CC_TMUX_SOCKET:-}" ]; then
  TMUX_ARGS=(-L "$CC_TMUX_SOCKET")
fi

tmux_cmd() {
  tmux "${TMUX_ARGS[@]}" "$@"
}

resolve_claude() {
  local found
  found=$(command -v claude 2>/dev/null)
  if [ -n "$found" ]; then
    printf '%s' "$found"
  else
    printf '%s' "$HOME/.local/bin/claude"
  fi
}

sha1_prefix() {
  if command -v sha1sum >/dev/null 2>&1; then
    printf '%s' "$1" | sha1sum | cut -c1-8
  else
    # BSD/macOS fallback: shasum is sha1sum's usual stand-in there.
    printf '%s' "$1" | shasum | cut -c1-8
  fi
}

# $1: raw text to derive a name from (e.g. a folder's basename). $2: the full path, used
# only as the hash source when $1 sanitizes to nothing (non-ASCII folder names and the like).
sanitize_name() {
  local sanitized
  sanitized=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9-]+/-/g' | cut -c1-32)
  if [ -z "${sanitized//-/}" ]; then
    printf 'd-%s' "$(sha1_prefix "${2:-$1}")"
  else
    printf '%s' "$sanitized"
  fi
}

# Mirrors src/conversations.js: Claude Code stores each folder's conversations under
# ~/.claude/projects/<encoded>/*.jsonl, where <encoded> is the absolute path with every
# character that is not [A-Za-z0-9] replaced by '-'. `claude --continue` exits immediately
# with "No conversation found to continue" when there is none, so only pass --continue when
# this says one exists.
has_conversation() {
  local dir
  dir="$PROJECTS_ROOT/$(printf '%s' "$1" | sed -E 's/[^A-Za-z0-9]/-/g')"
  ls "$dir"/*.jsonl >/dev/null 2>&1
}

# Prints the favorite's cwd on stdout and exits 0 if $1 is a known favorite name;
# exits 1 (nothing printed) otherwise.
favorite_cwd() {
  local name="$1"
  [ -f "$FAVORITES_FILE" ] || return 1
  node -e '
const fs = require("fs");
const [, file, name] = process.argv;
let items;
try { items = JSON.parse(fs.readFileSync(file, "utf8")); } catch { process.exit(1); }
if (!Array.isArray(items)) process.exit(1);
const fav = items.find((f) => f && f.name === name);
if (!fav || typeof fav.cwd !== "string") process.exit(1);
process.stdout.write(fav.cwd);
' "$FAVORITES_FILE" "$name"
}

list_sessions() {
  local out
  out=$(tmux_cmd list-sessions -F $'#{session_name}\t#{pane_current_path}' 2>/dev/null)
  [ -z "$out" ] && return 0
  while IFS=$'\t' read -r session path; do
    case "$session" in
      claude-*) printf '%-32s %s\n' "${session#claude-}" "$path" ;;
    esac
  done <<< "$out"
}

usage() {
  cat >&2 <<'USAGE'
Использование:
  cc                 открыть/создать сессию для текущей папки
  cc <имя|путь>      открыть/создать сессию по имени избранного или по пути
  cc -n [имя|путь]   начать НОВЫЙ разговор (без --continue)
  cc ls              список запущенных сессий claude-*
USAGE
}

NEW=0
POSITIONAL=()
for arg in "$@"; do
  case "$arg" in
    -n) NEW=1 ;;
    -h|--help) usage; exit 0 ;;
    *) POSITIONAL+=("$arg") ;;
  esac
done

if [ "${POSITIONAL[0]:-}" = "ls" ]; then
  list_sessions
  exit 0
fi

TARGET="${POSITIONAL[0]:-}"

if [ -z "$TARGET" ]; then
  CWD="$PWD"
  NAME=$(sanitize_name "$(basename "$CWD")" "$CWD")
elif FAV_CWD=$(favorite_cwd "$TARGET"); then
  CWD="$FAV_CWD"
  NAME="$TARGET"
elif [ -d "$TARGET" ]; then
  CWD=$(cd "$TARGET" 2>/dev/null && pwd)
  NAME=$(sanitize_name "$(basename "$CWD")" "$CWD")
else
  echo "Не найдено: $TARGET. Добавьте папку в избранное в приложении или укажите путь." >&2
  exit 1
fi

SESSION="claude-$NAME"

if tmux_cmd has-session -t "=$SESSION" 2>/dev/null; then
  EXISTS=1
else
  EXISTS=0
fi

if [ "$EXISTS" -eq 1 ]; then
  EXISTING_PATH=$(tmux_cmd list-panes -t "=$SESSION" -F '#{pane_current_path}' 2>/dev/null | head -n1)
  if [ -n "$EXISTING_PATH" ] && [ -n "$CWD" ] && [ "$EXISTING_PATH" != "$CWD" ]; then
    echo "Внимание: сессия «$SESSION» уже запущена в другой папке ($EXISTING_PATH), а не в $CWD" >&2
  fi
  if [ "$NEW" -eq 1 ]; then
    echo "Сессия «$SESSION» уже запущена — подключаюсь к ней (флаг -n проигнорирован: новый разговор не начат)." >&2
  fi
fi

if [ "$EXISTS" -eq 0 ]; then
  CLAUDE_BIN=$(resolve_claude)
  if [ "$NEW" -eq 1 ] || ! has_conversation "$CWD"; then
    tmux_cmd new-session -d -s "$SESSION" -c "$CWD" "$CLAUDE_BIN"
  else
    tmux_cmd new-session -d -s "$SESSION" -c "$CWD" "$CLAUDE_BIN" --continue
  fi
fi

# CC_NO_ATTACH is test-only: attaching needs a real TTY, which tests don't have.
if [ "${CC_NO_ATTACH:-}" = "1" ]; then
  exit 0
fi

if [ -n "${TMUX:-}" ]; then
  tmux_cmd switch-client -t "=$SESSION"
else
  # `exec tmux_cmd ...` doesn't work: exec replaces the process image with a program found on
  # PATH, and a shell function is not one, so it fails silently and attach never happens.
  exec tmux "${TMUX_ARGS[@]}" attach-session -t "=$SESSION"
fi
